{
  "manifest_version": 3,
  "name": "Gmail New Mail Console Logger",
  "description": "Logs newly received Gmail message subject and body details to the page console.",
  "version": "1.0.0",
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/mail/u/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage"],
  "host_permissions": ["https://mail.google.com/*"]
}
